<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F0F6FF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Pantry Manager"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#17365D"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Make the most of what you have."
        android:textSize="16sp"
        android:textColor="#3976C5"
        android:gravity="center"
        android:layout_marginBottom="36dp" />

    <Button
        android:id="@+id/btnPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textAllCaps="false"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#3976C5"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Find Recipes"
        android:textAllCaps="false"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#3976C5"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textAllCaps="false"
        android:backgroundTint="#DCEBFF"
        android:textColor="#17365D" />

</LinearLayout>
